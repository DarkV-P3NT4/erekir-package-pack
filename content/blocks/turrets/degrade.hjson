type: ItemTurret

name: "Degrade"
description: "Fires bursts of explosive corrosive shells at enemy targets, Requires ozone."
details: Somewhat similar to Titan?

health: 3850
size: 4
maxAmmo: 12
ammoPerShot: 1
reload: 240
squareSprite: false
liquidCapacity: 40
consumeAmmoOnce: false

requirements: [ tungsten/150, oxide/50, silicon/200, beryllium/300 ]
category: turret
outlineColor: 2D2D37

shootSound: shootTank
soundPitchMin: 0.8
soundPitchMax: 1
recoil: 1.5
cooldownTime: 240
recoilTime: 230
range: 308
shootEffect: shootBigColor
smokeEffect: shootSmokeSquareBig
inaccuracy: 3
velocityRnd: 0.1
minWarmup: 0.95
shootWarmupSpeed: 0.06
warmupMaintainTime: 150
heatColor: a0b380
rotateSpeed: 1.5

coolant: {
    type: ConsumeLiquid
    liquid: water
    amount: 0.5
}

consumes: {
   liquids: [ ozone/0.0666666666666 ]
}

coolantMultiplier: 5

drawer: {
    type: DrawTurret
    basePrefix: "reinforced-"
    parts: [
{
    type: RegionPart
    suffix: -barrel
    under: true
    moveY: 5.25
    heatColor: a0b380
    progress: {
    type: warmup
    ops: [
    { op: curve, interp: pow3 }
    { op: delay, amount: 0.15 }
    ]
    }
    moves: [
{
    type: PartMove
    y: -1.75
    progress: {
    type: recoil
    ops: [
    { op: curve, interp: pow3 }
]
    }
}
    ]
}
{
    type: RegionPart
    suffix: -side
    mirror: true
    heatColor: a0b380
    heatProgress: warmup
    moveY: -1.25
    progress: {
    type: recoil
    ops: [
    { op: curve, interp: pow3 }
]
    }
}
]
}

shoot: {
    shots: 3
    shotDelay: 30
}

ammoTypes: {

oxide: {
    type: BasicBulletType
    sprite: shell
    width: 18
    height: 20
    shrinkY: 0.1
    shrinkX: 0.2
    damage: 30
    splashDamage: 100
    splashDamageRadius: 120
    knockback: 1.5
    impact: true
    ammoMultiplier: 1
    status: corroded
    statusDuration: 420
    scaledSplashDamage: true
    hitEffect: [ smokeAoeCloud, titanSmokeLarge, titanExplosionLarge ]
    despawnEffect: none
